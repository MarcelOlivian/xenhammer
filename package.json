{
  "name": "xenhammer",
  "version": "0.0.1",
  "private": true,
  "description": "A web-based, WebGPU-accelerated level editor for GoldSrc in the spirit of Valve Hammer Editor 3.x",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "wgpu-matrix": "^3.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
